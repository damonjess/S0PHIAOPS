<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Sensitive device scan data must not be transferred -->
    <cloud-backup>
        <exclude domain="database" path="sophia-db" />
        <exclude domain="sharedpref" path="sophia_device_profiles.xml" />
        <exclude domain="sharedpref" path="sophia_investigation_store.xml" />
        <exclude domain="sharedpref" path="sophia_risk_tuning.xml" />
        <exclude domain="sharedpref" path="radar_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sophia-db" />
        <exclude domain="sharedpref" path="sophia_device_profiles.xml" />
        <exclude domain="sharedpref" path="sophia_investigation_store.xml" />
        <exclude domain="sharedpref" path="sophia_risk_tuning.xml" />
        <exclude domain="sharedpref" path="radar_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
