<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Sensitive device scan data must not be backed up -->
    <exclude domain="database" path="sophia-db" />
    <exclude domain="sharedpref" path="sophia_device_profiles.xml" />
    <exclude domain="sharedpref" path="sophia_investigation_store.xml" />
    <exclude domain="sharedpref" path="sophia_risk_tuning.xml" />
    <exclude domain="sharedpref" path="radar_preferences.xml" />
</full-backup-content>
